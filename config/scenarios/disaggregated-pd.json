{
  "id": "disaggregated-pd",
  "description": "Four-node prefill and four-node decode deployments joined by Mooncake direct KV transfer.",
  "mode": "disaggregated",
  "constraints": {
    "platforms": ["cuda"]
  },
  "features": {
    "external_kv_transfer": true,
    "disaggregated_prefill_decode": "mooncake"
  },
  "environment": {
    "FI_PROVIDER": "cxi",
    "UCCL_EP_TRANSPORT": "cxi",
    "FI_CXI_ENABLE_WRITEDATA": "1",
    "UCCL_EP_CPU_TIMEOUT_SECS": "600",
    "VLLM_DEEPEP_BUFFER_SIZE_MB": "1024",
    "VLLM_MOONCAKE_CONNECTOR_TIMEOUT": "120"
  },
  "deployments": {
    "prefill": {
      "nodes": 4,
      "api_port": 8100,
      "rpc_port": 13345,
      "bootstrap_port": 8998,
      "server": {
        "all2all-backend": "deepep_high_throughput",
        "kv-transfer-config": {
          "kv_connector": "MooncakeConnector",
          "kv_role": "kv_producer"
        }
      }
    },
    "decode": {
      "nodes": 4,
      "api_port": 8200,
      "rpc_port": 13346,
      "server": {
        "all2all-backend": "deepep_low_latency",
        "kv-transfer-config": {
          "kv_connector": "MooncakeConnector",
          "kv_role": "kv_consumer"
        }
      }
    },
    "proxy": {
      "port": 8000
    }
  }
}
